frigate:
  frigate_url: http://<frigate-host>:5000
  mqtt_server: <mqtt-host>
  mqtt_auth: false
  # mqtt_username: <mqtt-username>
  # mqtt_password: <mqtt-password>
  mqtt_port: 1883
  mqtt_use_tls: false
  mqtt_tls_insecure: false
  main_topic: frigate
  # Seconds to wait for an event snapshot before giving up.
  snapshot_timeout: 2
  camera:
    - <camera-name>
  object: bird
  # Other object labels (e.g. from a Home Assistant/Reolink automation, or
  # Frigate's own generic object detector) to log directly using the label
  # already assigned, without running WAMF's bird-species classifier on them.
  # Case-insensitive. Example: [squirrel, cat, rabbit, skunk]
  tracked_labels: []

classification:
  model: model.tflite
  threshold: 0.7
  # Use an upstream sub_label (Frigate, or an external classifier sending
  # ["Common Name", score]) instead of WAMF's model when it names a known species.
  prefer_sub_label: false

bridge:
  enabled: false
  events_url: http://192.168.1.112:5000/api/events
  timeout_seconds: 1
  health_check_interval_seconds: 60

webui:
  port: 7767
  host: 0.0.0.0
  # Optional external origin for the first-run setup link; no path or credentials.
  # public_base_url: https://wamf.example

storage:
  database_path: ./data/speciesid.db

media:
  snapshots_path: ./media/wamf/snapshots
  clips_path: ./media/wamf/clips

camera:
  live_view_url: ""

api:
  token_auth_enabled: true
  token_hash: ""

retention:
  enabled: true
  snapshots_days: 90
  clips_days: 90
  delete_media: false
  orphan_scan_enabled: true
  delete_orphaned_media: false
  system_events_days: 90
  system_events_min_rows: 1000
  config_backups_max_files: 10
  species_overrides: {}

admin:
  auth_enabled: true
  session_secret: "<long random session secret>"
  session_cookie_samesite: Lax
  session_cookie_secure: false
  password_hash: "<generated werkzeug password hash>"
